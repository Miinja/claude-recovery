#!/bin/sh
# Hook live-build, exécuté dans le chroot de l'image.
# Installe Claude Code pour tous les utilisateurs et prépare /opt/ordi.
set -e

REPO=/opt/ordi/claude-recovery
EDITION="$(cat /usr/share/ordi/edition)"

# Autorités de certification internes copiées par build-iso.sh (build/ca/*.crt)
update-ca-certificates

# --- Claude Code (installeur natif) ------------------------------------------
# L'installeur pose le binaire dans $HOME/.local : on lui donne /opt/claude comme
# HOME pour que l'installation soit commune, puis on l'expose dans /usr/local/bin.
export HOME=/opt/claude
mkdir -p "$HOME"
curl -fsSL https://claude.ai/install.sh | bash
chmod -R a+rX /opt/claude
ln -sf /opt/claude/.local/bin/claude /usr/local/bin/claude
/usr/local/bin/claude --version

# --- Arborescence de la clé ---------------------------------------------------
mkdir -p /opt/ordi/hooks /var/log/ordi /etc/ordi /etc/claude-code /mnt/jobs
chmod 755 "$REPO"/scripts/*.sh "$REPO"/hooks/*.sh
install -m 755 "$REPO"/hooks/*.sh /opt/ordi/hooks/
ln -sf "$REPO/scripts/ordi-session.sh" /usr/local/bin/ordi
ln -sf "$REPO/scripts/ordi-update.sh"  /usr/local/bin/ordi-update

# Interdictions en paramètres gérés dès le premier démarrage (avant tout git pull)
jq '{permissions: {deny: .permissions.deny}}' \
  "$REPO/config/$EDITION/settings.json" > /etc/claude-code/managed-settings.json

# L'utilisateur live (uid 1000, créé au démarrage par live-config) possède /opt/ordi
chown -R 1000:1000 /opt/ordi /var/log/ordi /mnt/jobs

# --- Mise à jour au démarrage ------------------------------------------------
install -m 644 "$REPO/scripts/ordi-update.service" /etc/systemd/system/
systemctl enable ordi-update.service

# Message d'accueil
cat > /etc/motd <<EOF

  Claude Recovery — édition $EDITION ($(cat /usr/share/ordi/version))
  Tapez  ordi  pour commencer.

EOF
