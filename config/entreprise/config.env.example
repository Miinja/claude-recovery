# Réglages d'une clé de l'édition entreprise : /etc/claude-recovery/config.env (partition de persistance).
# Écrit par l'installeur (ou scripts/make-key.sh) à la création de la clé.
# Ce fichier contient des jetons : il ne va JAMAIS dans le dépôt.

# Nom de l'entreprise (apparaît dans les rapports) et nom de la clé (dans les journaux)
RECOVERY_COMPANY='Exemple SARL'
RECOVERY_KEY_ID='cle01'

# Dépôt de config tiré au début de chaque session.
# Vide = dépôt GitHub public du projet. Sinon, le Forgejo de l'entreprise
# (jeton en lecture seule dans l'URL).
RECOVERY_GIT_URL='https://cle01:JETON_LECTURE_SEULE@git.exemple.lan/atelier/claude-recovery.git'

# Récepteur de journaux de l'entreprise (vide = journal local seul)
RECOVERY_LOG_URL='https://logs.exemple.lan'
RECOVERY_LOG_TOKEN='JETON_DE_CETTE_CLE'

# Dossier où sont créés les jobs (support de destination monté par le technicien)
RECOVERY_JOBS_DIR='/mnt/jobs'
