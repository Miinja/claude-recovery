# Settings of a business edition key: /etc/ctrl-z/config.env (persistence partition).
# Written by the installer (or scripts/make-key.sh) when the key is created.
# This file holds tokens: it NEVER goes into the repository.

# Company name (identifies who the key belongs to) and key name (shown in the logs)
RECOVERY_COMPANY='Exemple SARL'
RECOVERY_KEY_ID='cle01'

# Configuration repository pulled at the start of every session.
# Empty = the project's public GitHub repository. Otherwise the company's own copy
# (read-only token in the URL).
RECOVERY_GIT_URL='https://cle01:JETON_LECTURE_SEULE@git.exemple.lan/atelier/ctrl-z.git'

# The company's log receiver (empty = local log only)
RECOVERY_LOG_URL='https://logs.exemple.lan'
RECOVERY_LOG_TOKEN='JETON_DE_CETTE_CLE'

# Folder where jobs are created (the destination drive is mounted there)
RECOVERY_JOBS_DIR='/mnt/jobs'
