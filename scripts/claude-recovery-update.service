[Unit]
Description=Claude Recovery - mise a jour de la config (git pull)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=recovery
Environment=HOME=/home/recovery
ExecStart=/opt/claude-recovery/repo/scripts/update.sh
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
