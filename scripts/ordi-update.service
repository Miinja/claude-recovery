[Unit]
Description=Claude Recovery - mise a jour de la config (git pull)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ordi
Environment=HOME=/home/ordi
ExecStart=/opt/ordi/claude-recovery/scripts/ordi-update.sh
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
