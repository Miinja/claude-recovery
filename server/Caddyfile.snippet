# Add to the existing Caddyfile, then reload Caddy.
# Replace the names with those of server/.env.
#
# Internal name (not resolved on the Internet): keep `tls internal`. The keys must then
# trust Caddy's local authority (see README.md).
# Public name: remove `tls internal`, Caddy gets a certificate by itself.

git.exemple.lan {
	tls internal
	reverse_proxy forgejo:3000
}

logs.exemple.lan {
	tls internal
	request_body {
		max_size 6MB
	}
	reverse_proxy log-receiver:8080
}
