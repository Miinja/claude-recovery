# À copier en .env (jamais commité) et à adapter.

# Nom sous lequel les clés joignent Forgejo et le récepteur de journaux
GIT_DOMAIN=git.exemple.lan
LOGS_DOMAIN=logs.exemple.lan

# Réseau Docker sur lequel tourne déjà le conteneur Caddy (docker network ls)
CADDY_NETWORK=caddy

# Version majeure de Forgejo
FORGEJO_VERSION=17
